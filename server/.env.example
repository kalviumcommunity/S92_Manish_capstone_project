# Copy this file to server/.env and fill in the values.

# MongoDB connection string (MongoDB Atlas for production)
MONGO_URI=mongodb://127.0.0.1:27017/community-connect

# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID in the client)
GOOGLE_CLIENT_ID=

# Frontend URL(s) allowed by CORS, comma-separated. Leave empty in development.
CLIENT_URL=

# Port (hosting platforms usually set this automatically)
PORT=5000

# Google Gemini API key for AI insights (free key: https://aistudio.google.com/apikey)
# Leave empty to disable AI insights.
GEMINI_API_KEY=

# Optional: Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
