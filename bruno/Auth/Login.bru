meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Save the JWT for the other requests
  if (res.body && res.body.token) {
    bru.setVar("token", res.body.token);
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a JWT", function () {
    expect(res.body.token).to.be.a("string");
  });
}

docs {
  Logs in with username and password and returns a JWT valid for 1 hour.
  The post-response script saves it to the `token` variable.

  **Auth:** none

  **Body:** `{ "username": "...", "password": "..." }`

  **Responses**
  - 200 `{ message, token, user }`
  - 400 missing fields
  - 401 invalid username or password
}
