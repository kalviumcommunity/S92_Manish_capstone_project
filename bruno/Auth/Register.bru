meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test Organizer",
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "role": "organizer"
  }
}

script:pre-request {
  // Unique username/email so the collection can be run many times
  const runId = Date.now();
  bru.setVar("username", "tester" + runId);
  bru.setVar("email", "tester" + runId + "@example.com");
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("does not return the password", function () {
    expect(res.body.user.password).to.be.undefined;
  });
}

docs {
  Creates an account with a bcrypt-hashed password.

  **Auth:** none

  **Body**
  | Field | Type | Required | Notes |
  |---|---|---|---|
  | name | string | yes | |
  | username | string | yes | unique |
  | email | string | yes | unique, stored lowercase |
  | password | string | yes | |
  | role | string | no | `participant` (default) or `organizer`. Admin cannot be self-assigned. |

  **Responses**
  - 201 `{ message, user: { id, name, username, email, role } }`
  - 400 missing fields
  - 409 username or email already exists
}
