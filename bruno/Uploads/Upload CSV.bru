meta {
  name: Upload CSV
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/uploads
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file(sample-data/engagements.csv)
}

script:post-response {
  if (res.body && res.body.upload) {
    bru.setVar("uploadId", res.body.upload.id);
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("imports the valid rows", function () {
    expect(res.body.imported).to.equal(2);
    expect(res.body.skipped).to.equal(1);
  });
}

docs {
  Uploads a CSV file and imports each row as an engagement.

  **Auth:** Bearer token

  **Body:** `multipart/form-data` with field `file` (.csv, max 2 MB, max 1000 rows)

  **Columns** (header names are case-insensitive)
  | Column | Required |
  |---|---|
  | Participant Name | yes |
  | Email | yes |
  | Program | yes (must match an existing program name) |
  | Sessions Attended, Total Sessions, Engagement Score, Satisfaction Score, Feedback | no |

  New participants are created by email; existing engagements are updated.

  **Responses**
  - 201 `{ message, upload, imported, skipped, errors: [{ row, message }] }`
  - 400 no file, not a CSV, too large, or missing columns
}
